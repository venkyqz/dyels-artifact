// Simple query to remove minimal proxies, no storage instructions + delegatecall to a constant address
.decl Analytics_MinimalProxy()
.output Analytics_MinimalProxy

Analytics_MinimalProxy():-
  DELEGATECALL(_, _, addr, _, _, _, _, _),
  Variable_Value(addr, _),
  !SLOAD(_, _, _),
  !SSTORE(_, _, _).